---
// Главная = страница текущего тома. docs/pages.md → «Главная тома», design/screens/01-tome-home.jpg
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import TocItem from '../components/TocItem.astro';
import FeedCard from '../components/FeedCard.astro';
import JudgeCard from '../components/JudgeCard.astro';
import Spine from '../components/Spine.astro';
import Footer from '../components/Footer.astro';
import { slugFromId } from '../lib/content/slug';
import '../styles/home.css';

const tomes = (await getCollection('tomes', ({ data }) => data.status === 'published')).sort(
  (a, b) => b.data.number - a.data.number,
);
const tome = tomes[0];
if (!tome) throw new Error('Нет ни одного опубликованного тома в src/content/tomes/');

const articles = (await getCollection('articles', ({ data }) => data.tome === tome.data.number)).sort(
  (a, b) => a.data.order - b.data.order,
);
const firstArticle = articles.find((a) => a.data.status === 'published');
const coverSrc = tome.data.coverSvg ?? tome.data.cover;

const RUBRICS = [
  { title: 'Judge me by cover', text: 'Обложки первых изданий: кто нарисовал и почему это работает.' },
  { title: 'Оскар от HDaily', text: 'Своя премия главреда: фильмы, книги и альбомы года.' },
  { title: 'Из дневника', text: 'Короткие записи о том, что зацепило.' },
  { title: 'Разговоры во сне', text: 'Диалоги на границе сна и науки.' },
];
---

<Base title={tome.data.title} description={tome.data.lede} tome={tome.data.number} image={tome.data.cover}>
  <Header tomeNumber={tome.data.number} tomeTitle={tome.data.title} />
  <main>
    <h1 class="sr-only">Том {tome.data.number}. {tome.data.title}</h1>
    <section class="home-hero">
      <div class="home-hero__cover">{coverSrc && <img src={coverSrc} alt={tome.data.coverAlt} width="700" height="933" fetchpriority="high" loading="eager" />}</div>
      <div class="home-hero__content">
        <p class="home-hero__meta">Том {tome.data.number} из шести в этом году</p>
        <p class="home-hero__lede">{tome.data.lede}</p>
        <ol class="home-hero__toc">
          {articles.map((entry) => <TocItem order={entry.data.order} entry={entry} />)}
        </ol>
        {
          firstArticle && (
            <a class="home-hero__button" href={`/tom/${tome.data.number}/${slugFromId(firstArticle.id)}/`}>
              Читать том с начала
              <span class="home-hero__button-dot" aria-hidden="true" />
            </a>
          )
        }
        {
          tome.data.publishedAt && (
            <p class="home-hero__next-tome">Следующий том выйдет {tome.data.publishedAt.toLocaleDateString('ru-RU')}. Пока его нет, читайте ленту.</p>
          )
        }
      </div>
    </section>

    <section class="home-section">
      <h2 class="home-section__heading">В томе</h2>
      <p class="home-section__lede">четыре текста соавтора и рубрика главреда</p>
      <div class="home-grid">
        {
          articles.map((entry) =>
            entry.data.status === 'draft' ? (
              <JudgeCard />
            ) : (
              <FeedCard entry={entry} caption={`Материал ${entry.data.order} из ${articles.length}`} />
            ),
          )
        }
      </div>
    </section>

    <section class="home-section">
      <h2 class="home-section__heading">Лента</h2>
      <p class="home-section__lede">то, что выходит между томами</p>
      <div class="home-grid home-grid--lenta">
        {Array.from({ length: 4 }).map(() => (
          <div class="home-feed-placeholder">следующий материал ленты</div>
        ))}
      </div>
    </section>

    <section class="home-section">
      <div class="home-rubrics">
        <div class="home-rubrics__intro">
          <h2 class="home-section__heading">Рубрики главреда</h2>
          <p>Мансур пишет редко и только в своих рубриках. Каждая открывает подборку всех её выпусков.</p>
        </div>
        <ul class="home-rubrics__list">
          {RUBRICS.map((rubric) => (
            <li>
              <p class="home-rubric__title">
                <span class="home-rubric__dot" aria-hidden="true" />
                {rubric.title}
              </p>
              <p class="home-rubric__text">{rubric.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="home-section">
      <h2 class="home-section__heading">Полка</h2>
      <p class="home-section__lede">Архив томов. Каждый том стоит корешком своего цвета, по нажатию открывается целиком.</p>
      <Spine tomes={tomes} />
    </section>
  </main>
  <Footer variant="full" />
</Base>
