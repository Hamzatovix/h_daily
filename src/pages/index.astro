---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Spine from '../components/Spine.astro';
import ReadingMemory from '../components/ReadingMemory.astro';
import { slugFromId } from '../lib/content/slug';
import '../styles/home.css';
const tomes = (await getCollection('tomes', ({data}) => data.status === 'published')).sort((a,b)=>b.data.number-a.data.number);
const tome = tomes[0];
if (!tome) throw new Error('Нет опубликованного тома');
const articles = await getCollection('articles', ({data})=>data.status === 'published' && data.tome === tome.data.number);
const rubrics = [['Judge me by cover', 'Обложки первых изданий: кто нарисовал и почему это работает.'], ['Оскар от HDaily', 'Своя премия главреда: фильмы, книги и альбомы года.'], ['Из дневника', 'Короткие записи о том, что зацепило.'], ['Разговоры во сне', 'Диалоги на границе сна и науки.']];
---
<Base description={tome.data.lede} image={tome.data.cover} coverFrame>
  <Header tomeNumber={tome.data.number} tomeTitle={tome.data.title} />
  <main class="journal-home">
    <section class="home-hero journal-cover">
      <a class="home-hero__cover" href={`/tom/${tome.data.number}/`}><img src={tome.data.coverSvg ?? tome.data.cover} alt={tome.data.coverAlt} width="700" height="933" fetchpriority="high" /></a>
      <div class="home-hero__content">
        <p class="home-hero__meta">Текущий выпуск · Том {tome.data.number}</p>
        <h1 class="journal-title">HAMZATOVIC daily</h1>
        <h2 class="journal-tome-title">{tome.data.title}</h2>
        <p class="home-hero__lede">{tome.data.lede}</p>
        <a class="home-hero__button" href={`/tom/${tome.data.number}/`}>Открыть том <span class="home-hero__button-dot" aria-hidden="true" /></a>
        {articles.map(entry=><a hidden data-resume-link class="home-resume" href={`/tom/${tome.data.number}/${slugFromId(entry.id)}/#continue`}>Продолжить: {entry.data.title}</a>)}
      </div>
    </section>
    <section class="home-section">
      <div class="journal-section-heading"><h2 class="home-section__heading">Тома</h2><a href="/toma/">Все тома</a></div>
      <p class="home-section__lede">Каждый выпуск — одна тема.</p>
      <Spine tomes={tomes} totalPerYear={tomes.length} />
    </section>
    <section class="home-section">
      <h2 class="home-section__heading">Рубрики главреда</h2>
      <ul class="journal-rubrics">{rubrics.map(([title,text])=><li><p class="home-rubric__title"><span class="home-rubric__dot" aria-hidden="true" />{title}</p><p class="home-rubric__text">{text}</p></li>)}</ul>
    </section>
  </main>
  <Footer variant="full" />
  <ReadingMemory tome={tome.data.number} />
</Base>
<style>
  .journal-home { padding-bottom: var(--space-96); }
  .journal-cover { margin-bottom: var(--space-128); }
  .journal-title { font-family: var(--font-display); font-size: var(--fs-subhead); line-height: var(--lh-subhead); font-weight: 400; overflow-wrap: anywhere; margin: var(--space-24) 0; }
  .journal-tome-title { font-family: var(--font-text); font-size: var(--fs-subhead); line-height: var(--lh-subhead); margin: 0; }
  .journal-section-heading { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-24); }
  .journal-section-heading a { color: var(--ink); font-size: var(--fs-meta); }
  .journal-rubrics { list-style: none; padding: 0; margin: var(--space-32) 0 0; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: var(--space-32); }
  .journal-rubrics li { border-top: var(--hairline) solid var(--ink); padding-top: var(--space-16); }
  @media(max-width:1024px) {
    .journal-cover { margin-bottom: var(--space-64); }
    .journal-title { font-size: var(--fs-flap-label); line-height: var(--lh-flap-label); }
    .journal-rubrics { grid-template-columns: minmax(0,1fr); }
  }
</style>
