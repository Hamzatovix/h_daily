---
// Статья тома. docs/pages.md → /tom/1/belyj-kit-s-mott-strit/
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import TomeFrame from '../../../components/TomeFrame.astro';
import ArticleHero from '../../../components/ArticleHero.astro';
import Flap from '../../../components/Flap.astro';
import NextInTome, { type NextCard } from '../../../components/NextInTome.astro';
import Footer from '../../../components/Footer.astro';
import { slugFromId } from '../../../lib/content/slug';
import { AUTHORS } from '../../../lib/content/authors';
import { readingTimeLabel } from '../../../lib/format/pluralize';
import '../../../styles/article.css';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => data.status === 'published');
  return articles.map((entry) => ({
    params: { tome: String(entry.data.tome), slug: slugFromId(entry.id) },
    props: { entryId: entry.id },
  }));
}

const { entryId } = Astro.props;

const siblings = (await getCollection('articles')).sort((a, b) => a.data.order - b.data.order);
const entry = siblings.find((s) => s.id === entryId);
if (!entry) throw new Error(`Статья ${entryId} не найдена`);

const tomeSiblings = siblings.filter((s) => s.data.tome === entry.data.tome);
const position = tomeSiblings.findIndex((s) => s.id === entry.id) + 1;
const total = tomeSiblings.length;

const tome = (await getCollection('tomes')).find((t) => t.data.number === entry.data.tome);
if (!tome) throw new Error(`Том ${entry.data.tome} не найден`);

const { Content } = await render(entry);

const upcoming = tomeSiblings.filter((s) => s.data.order > entry.data.order);
const cards: NextCard[] = [];

for (let i = 0; i < 2; i++) {
  const next = upcoming[i];
  const captionPrefix = i === 0 ? 'Дальше в томе, ' : '';
  if (next) {
    if (next.data.status === 'draft') {
      cards.push({
        kind: 'judge',
        title: next.data.title,
        caption: `${AUTHORS[next.data.author].name}, скоро`,
      });
    } else {
      cards.push({
        kind: 'article',
        href: `/tom/${next.data.tome}/${slugFromId(next.id)}/`,
        cover: next.data.coverSmall ?? next.data.cover,
        coverAlt: next.data.coverAlt,
        caption: `${captionPrefix}${next.data.order} из ${total}`,
        title: next.data.title,
        author: AUTHORS[next.data.author].name,
        minutes: next.data.readingTime !== null ? readingTimeLabel(next.data.readingTime) : 'скоро',
      });
    }
  } else {
    const minutes = tomeSiblings.reduce((sum, s) => sum + (s.data.readingTime ?? 0), 0);
    cards.push({
      kind: 'toc',
      href: `/tom/${tome.data.number}/`,
      cover: tome.data.cover,
      coverAlt: tome.data.coverAlt,
      tomeTitle: tome.data.title,
      summary: `${total} материалов, ${minutes} минут`,
    });
  }
}
---

<Base title={entry.data.title} description={entry.data.subtitle} tome={entry.data.tome}>
  <TomeFrame slot="frame" readingTime={entry.data.readingTime} />
  <Header tomeNumber={tome.data.number} tomeTitle={tome.data.title} mobileLabel={`${position} из ${total}`} />
  <main>
    <ArticleHero entry={entry} position={position} total={total} />
    <div class="article-grid">
      <Flap flap={entry.data.flap} author={entry.data.author} />
      <Content />
    </div>
  </main>
  <NextInTome cards={cards} />
  <Footer />
</Base>
