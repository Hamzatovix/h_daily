---
// Лента: материалы между томами. docs/pages.md → «Страницы без макета». Пока пусто.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/home.css';

const tomes = (await getCollection('tomes', ({ data }) => data.status === 'published')).sort(
  (a, b) => b.data.number - a.data.number,
);
const tome = tomes[0];
if (!tome) throw new Error('Нет ни одного опубликованного тома в src/content/tomes/');
---

<Base title="Лента" tome={tome.data.number}>
  <Header tomeNumber={tome.data.number} tomeTitle={tome.data.title} />
  <main>
    <section class="home-section">
      <h1 class="home-section__heading">Лента</h1>
      <p class="home-section__lede">то, что выходит между томами</p>
      <p class="lenta-empty">
        Пока здесь пусто.
        {tome.data.publishedAt ? ` Следующий том выйдет ${tome.data.publishedAt.toLocaleDateString('ru-RU')} — а пока` : ' Пока его нет,'}
        {' '}читайте <a href={`/tom/${tome.data.number}/`}>том {tome.data.number}</a>.
      </p>
    </section>
  </main>
  <Footer variant="full" />
</Base>

<style>
  .lenta-empty {
    max-width: var(--text-measure);
    font-family: var(--font-text);
    font-style: italic;
  }

  .lenta-empty a {
    color: var(--ink);
  }
</style>
