---
// Временная страница шага 3: показывает результат обработки текста без оформления.
// Заменится реальной страницей статьи на шаге 4.
import { getEntry, render } from 'astro:content';

const entry = await getEntry('articles', 'tome-1/01-belyj-kit-s-mott-strit');
if (!entry) throw new Error('Статья не найдена');
const { Content } = await render(entry);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <title>Предпросмотр обработки текста — {entry.data.title}</title>
  </head>
  <body>
    <h1>{entry.data.title}</h1>
    <article>
      <Content />
    </article>
  </body>
</html>
