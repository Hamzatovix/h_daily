---
// docs/components.md → TomeFrame, design/brandbook/components/TomeFrame.md
// Рамка-прогресс для статьи: на компьютере верхний край, на телефоне весь периметр.
interface Props {
  readingTime: number | null;
}
const { readingTime } = Astro.props;
---

<div class="tome-frame" aria-hidden="true" data-reading-time={readingTime ?? ''}>
  <div class="tome-frame__top">
    <div class="tome-frame__fill"></div>
    <span class="tome-frame__label"></span>
  </div>
  <svg class="tome-frame__mobile" aria-hidden="true">
    <path class="tome-frame__mobile-track" />
    <path class="tome-frame__mobile-fill" pathLength="100" />
  </svg>
</div>

<script>
  function pluralizeRu(n: number, forms: [string, string, string]): string {
    const mod10 = n % 10;
    const mod100 = n % 100;
    if (mod10 === 1 && mod100 !== 11) return forms[0];
    if (mod10 >= 2 && mod10 <= 4 && (mod100 < 10 || mod100 >= 20)) return forms[1];
    return forms[2];
  }

  const frame = document.querySelector<HTMLElement>('.tome-frame');
  const paragraphs = document.querySelectorAll<HTMLElement>('.article-grid > p');
  if (!frame || paragraphs.length === 0) {
    // Без скрипта или без текста статьи рамка остаётся просто цветной (CSS по умолчанию).
  } else {
    const readingTime = Number(frame.dataset.readingTime) || 0;
    const fill = frame.querySelector<HTMLElement>('.tome-frame__fill');
    const label = frame.querySelector<HTMLElement>('.tome-frame__label');
    const mobileFill = frame.querySelector<SVGPathElement>('.tome-frame__mobile-fill');
    const mobileTrack = frame.querySelector<SVGPathElement>('.tome-frame__mobile-track');
    const mobileSvg = frame.querySelector<SVGSVGElement>('.tome-frame__mobile');
    frame.classList.add('tome-frame--active');

    const first = paragraphs[0];
    const last = paragraphs[paragraphs.length - 1];

    function sizeMobileFrame() {
      if (!mobileSvg) return;
      const { width, height } = mobileSvg.getBoundingClientRect();
      if (!width || !height) return;
      mobileSvg.setAttribute('viewBox', `0 0 ${width} ${height}`);
      const half = parseFloat(getComputedStyle(frame!).getPropertyValue('--frame-mobile')) / 2 || 4;
      const radius = Math.min(12, width / 8, height / 8);
      const right = width - half;
      const bottom = height - half;
      const path = `M ${half + radius} ${half} H ${right - radius} Q ${right} ${half} ${right} ${half + radius} V ${bottom - radius} Q ${right} ${bottom} ${right - radius} ${bottom} H ${half + radius} Q ${half} ${bottom} ${half} ${bottom - radius} V ${half + radius} Q ${half} ${half} ${half + radius} ${half} Z`;
      mobileFill?.setAttribute('d', path);
      mobileTrack?.setAttribute('d', path);
    }

    function update() {
      const top = first.getBoundingClientRect().top + window.scrollY;
      const bottom = last.getBoundingClientRect().bottom + window.scrollY;
      const viewportHeight = document.documentElement.clientHeight;
      const start = Math.max(0, top - viewportHeight * 0.3);
      const end = Math.max(start + 1, bottom - viewportHeight + 32);
      const rawProgress = Math.min(Math.max((window.scrollY - start) / (end - start), 0), 1);
      const progress = rawProgress >= 0.999 ? 1 : rawProgress;

      if (fill) fill.style.width = `${progress * 100}%`;
      if (mobileFill) mobileFill.style.strokeDashoffset = String(100 * (1 - progress));

      if (label) {
        if (progress >= 0.999 || readingTime <= 0) {
          label.textContent = '';
        } else {
          const minutesLeft = Math.ceil(readingTime * (1 - progress));
          label.textContent = `ещё ${minutesLeft} ${pluralizeRu(minutesLeft, ['минута', 'минуты', 'минут'])}`;
          const available = frame!.getBoundingClientRect().width;
          label.style.left = `${Math.max(8, Math.min(progress * available + 8, available - label.offsetWidth - 8))}px`;
        }
      }
    }

    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    }

    sizeMobileFrame();
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      sizeMobileFrame();
      update();
    });
    const article = document.querySelector('.article-grid');
    if (article) new ResizeObserver(onScroll).observe(article);
    if (mobileSvg) new ResizeObserver(() => { sizeMobileFrame(); onScroll(); }).observe(mobileSvg);
    window.visualViewport?.addEventListener('resize', onScroll);
    document.fonts.ready.then(onScroll);
  }
</script>

<style>
  .tome-frame {
    position: fixed;
    inset: 0;
    z-index: 100;
    border: var(--frame-desktop) solid var(--tome);
    pointer-events: none;
  }

  .tome-frame__top,
  .tome-frame__mobile {
    display: none;
  }

  .tome-frame--active {
    border-top-color: transparent;
  }

  .tome-frame--active .tome-frame__top {
    display: block;
    position: absolute;
    top: calc(var(--frame-desktop) * -1);
    left: calc(var(--frame-desktop) * -1);
    right: calc(var(--frame-desktop) * -1);
    height: var(--frame-desktop);
    background: var(--rule);
  }

  .tome-frame__fill {
    height: 100%;
    width: 0%;
    background: var(--tome);
  }

  @media (prefers-reduced-motion: no-preference) {
    .tome-frame__fill {
      transition: width 120ms linear;
    }
  }

  .tome-frame__label {
    position: absolute;
    top: 0;
    line-height: var(--frame-desktop);
    padding: 0 var(--space-4);
    background: var(--tome);
    white-space: nowrap;
    font-family: var(--font-text);
    font-style: italic;
    font-size: 13px;
    color: var(--on-tome);
  }

  @media (max-width: 767px) {
    .tome-frame {
      border-width: var(--frame-mobile);
    }

    .tome-frame--active {
      border: 0;
    }

    .tome-frame--active .tome-frame__top {
      display: none;
    }

    .tome-frame--active .tome-frame__mobile {
      display: block;
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .tome-frame__mobile-track,
    .tome-frame__mobile-fill {
      fill: none;
      stroke-width: var(--frame-mobile);
      stroke-linejoin: miter;
      stroke-linecap: butt;
    }

    .tome-frame__mobile-track {
      stroke: var(--rule);
    }

    .tome-frame__mobile-fill {
      stroke: var(--tome);
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
    }

    @media (prefers-reduced-motion: no-preference) {
      .tome-frame__mobile-fill {
        transition: stroke-dashoffset 80ms linear;
      }
    }
  }
</style>
