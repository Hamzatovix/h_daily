  }

  .judge-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-flap-label);
  }

  .judge-card__placeholder {
    flex: 1;
    margin: var(--space-16) 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    border: var(--hairline) dashed var(--paper);
    font-family: var(--font-text);
    font-style: italic;
    font-size: var(--fs-note);
    padding: var(--space-16);
  }

  .judge-card__caption {
    margin: 0;
    font-family: var(--font-text);
    font-size: var(--fs-meta);
  }
</style>
