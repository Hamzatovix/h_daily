---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import { slugFromId } from '../lib/content/slug';
interface Props { tomeNumber: number; tomeTitle: string; mobileLabel?: string }
const { tomeNumber, tomeTitle, mobileLabel } = Astro.props;
const entries = (await getCollection('articles', ({data})=>data.tome===tomeNumber)).sort((a,b)=>a.data.order-b.data.order);
const links = [['/', 'Главная'], [`/tom/${tomeNumber}/`, `Том ${tomeNumber}. ${tomeTitle}`], ['/lenta/', 'DAILY'], ['/toma/', 'Все тома'], ['/o-zhurnale/', 'О журнале']];
---
<div class="mobile-navigation">
  <button class="menu-trigger" aria-label="Открыть меню" aria-haspopup="dialog" aria-controls="journal-menu" aria-expanded="false"><span aria-hidden="true">☰</span>{mobileLabel && <span class="menu-position">{mobileLabel}</span>}</button>
  <dialog id="journal-menu" aria-labelledby="menu-heading">
    <div class="menu-top"><Logo class="menu-logo" /><button class="menu-close" aria-label="Закрыть меню">×</button></div>
    <h2 id="menu-heading" class="sr-only">Навигация журнала</h2>
    <nav aria-label="Разделы журнала"><ul class="menu-sections">{links.map(([href,label])=><li><a href={href} aria-current={Astro.url.pathname===href ? 'page' : undefined}>{label}</a></li>)}</ul></nav>
    {entries.filter(e=>e.data.status==='published').map(entry=><a hidden data-resume-link class="home-resume" href={`/tom/${tomeNumber}/${slugFromId(entry.id)}/#continue`}>Продолжить: {entry.data.title}</a>)}
    {mobileLabel && <nav class="menu-contents" aria-label="В этом томе"><h2>В этом томе</h2><ol>{entries.map(entry=>{
      const href=`/tom/${tomeNumber}/${slugFromId(entry.id)}/`;
      return <li>{entry.data.status==='published' ? <a href={href} data-reading-link aria-current={Astro.url.pathname===href ? 'page' : undefined}>{entry.data.title}</a> : <span>{entry.data.title} · скоро</span>}</li>;
    })}</ol></nav>}
  </dialog>
</div>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#journal-menu');
  const trigger = document.querySelector<HTMLButtonElement>('.menu-trigger');
  if (dialog && trigger) {
    let previousOverflow = '';
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let closeTimer = 0;
    const close = () => {
      if (!dialog.open || dialog.classList.contains('is-closing')) return;
      if (reducedMotion.matches) { dialog.close(); return; }
      dialog.classList.add('is-closing');
      closeTimer = window.setTimeout(() => dialog.close(), 260);
    };
    dialog.addEventListener('animationend', event => {
      if (event.target === dialog && event.animationName.includes('hide-menu')) dialog.close();
    });
    dialog.addEventListener('cancel', event => { event.preventDefault(); close(); });
    trigger.addEventListener('click', () => {
      if (dialog.open) return;
      dialog.classList.remove('is-closing');
      previousOverflow = document.documentElement.style.overflow;
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
      trigger.setAttribute('aria-expanded', 'true');
    });
    dialog.querySelector('.menu-close')?.addEventListener('click', close);
    dialog.addEventListener('click', event => { if (event.target===dialog) {
      const r=dialog.getBoundingClientRect();
      if (event.clientX<r.left || event.clientX>r.right || event.clientY<r.top || event.clientY>r.bottom) close();
    }});
    dialog.addEventListener('close', () => {
      clearTimeout(closeTimer);
      dialog.classList.remove('is-closing');
      document.documentElement.style.overflow = previousOverflow;
      trigger.setAttribute('aria-expanded', 'false');
      trigger.focus();
    });
    matchMedia('(min-width: 1025px)').addEventListener('change', event => { if(event.matches && dialog.open) close(); });
    reducedMotion.addEventListener('change', event => { if (event.matches && dialog.classList.contains('is-closing')) dialog.close(); });
  }
</script>
<style>
  .mobile-navigation { display: none; }
  .menu-trigger,.menu-close { border: 0; background: transparent; color: var(--ink); min-width: 44px; min-height: 44px; padding: 0; cursor: pointer; }
  .menu-trigger { display: flex; align-items: center; gap: var(--space-4); font-size: var(--fs-flap-label); }
  .menu-position { font-family: var(--font-text); font-size: var(--fs-meta); white-space: nowrap; }
  .menu-close { font-size: var(--fs-subhead); line-height: 1; }
  dialog { margin: 0; width: min(400px,calc(100% - 24px)); max-width: none; height: 100dvh; max-height: 100dvh; border: 0; border-right: var(--hairline) dashed var(--ink); padding: var(--space-24) var(--page-margin-mobile); background: var(--flap); color: var(--ink); overflow-y: auto; overscroll-behavior: contain; }
  dialog::backdrop { background: var(--ink); opacity: .35; }
  .menu-top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-16); }
  :global(.menu-logo) { height: 17px; min-width: 0; }
  .menu-sections { list-style: none; padding: 0; margin: var(--space-32) 0; }
  .menu-sections li { border-top: var(--hairline) solid var(--ink); }
  a { color: var(--ink); text-decoration: none; display: block; padding: var(--space-8) 0; overflow-wrap: anywhere; }
  .menu-sections a { font-size: var(--fs-card-title); line-height: var(--lh-card-title); padding: var(--space-16) 0; }
  [aria-current] { text-decoration: underline; text-decoration-color: var(--tome); text-underline-offset: 5px; }
  [data-read]::after { content: ' · прочитано'; font-size: var(--fs-meta); }
  .menu-contents h2 { font-family: var(--font-display); font-size: var(--fs-flap-label); font-weight: 400; }
  .menu-contents ol { padding-left: var(--space-24); }
  .menu-contents li { font-size: var(--fs-flap-text); line-height: var(--lh-flap-text); }
  .home-resume[hidden] { display: none; }
  @media(max-width:1024px) { .mobile-navigation { display: block; flex: none; } }
  @media(prefers-reduced-motion:no-preference) {
    dialog[open] { animation: reveal-menu 320ms cubic-bezier(.22,1,.36,1) both; }
    dialog[open]::backdrop { animation: reveal-backdrop 280ms ease-out both; }
    dialog[open].is-closing { animation: hide-menu 220ms cubic-bezier(.4,0,1,1) both; }
    dialog[open].is-closing::backdrop { animation: hide-backdrop 220ms ease-in both; }
    @keyframes reveal-menu { from { transform: translateX(-100%); } to { transform: translateX(0); } }
    @keyframes hide-menu { from { transform: translateX(0); } to { transform: translateX(-100%); } }
    @keyframes reveal-backdrop { from { opacity: 0; } to { opacity: .35; } }
    @keyframes hide-backdrop { from { opacity: .35; } to { opacity: 0; } }
  }
</style>
