---
// docs/components.md, design/brandbook/README.md → ThemeToggle
---

<button type="button" class="theme-toggle" aria-label="Ночной режим" aria-pressed="false"></button>

<script>
  const STORAGE_KEY = 'theme';
  const root = document.documentElement;

  function isNight(): boolean {
    if (root.dataset.theme === 'night') return true;
    if (root.dataset.theme === 'day') return false;
    return window.matchMedia('(prefers-color-scheme: dark)').matches;
  }

  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
    button.setAttribute('aria-pressed', String(isNight()));

    button.addEventListener('click', () => {
      const next = isNight() ? 'day' : 'night';
      root.dataset.theme = next;
      try {
        localStorage.setItem(STORAGE_KEY, next);
      } catch {
        // хранилище недоступно — переключаем только на текущую сессию
      }
      document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((b) => {
        b.setAttribute('aria-pressed', String(isNight()));
      });
    });
  });
</script>

<style>
  .theme-toggle {
    position: relative;
    width: 20px;
    height: 20px;
    padding: 0;
    overflow: hidden;
    border: var(--hairline) solid var(--ink);
    border-radius: var(--radius-dot);
    background: var(--paper);
    cursor: pointer;
  }

  .theme-toggle::after {
    content: '';
    position: absolute;
    inset: 0;
    left: 50%;
    background: var(--ink);
  }
</style>
