---
// docs/components.md, design/brandbook/components/Header.md
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';
import MobileNav from './MobileNav.astro';

interface Props {
  tomeNumber: number;
  tomeTitle: string;
  /** В статье на телефоне слева вместо «Том N» — номер материала («3 из 5»). */
  mobileLabel?: string;
}
const { tomeNumber, tomeTitle, mobileLabel } = Astro.props;
---

<header class="site-header">
  <MobileNav tomeNumber={tomeNumber} tomeTitle={tomeTitle} mobileLabel={mobileLabel} />
  <a class="site-header__tome site-header__tome--desktop" href={`/tom/${tomeNumber}/`}>Том {tomeNumber}. {tomeTitle}</a>
  <a class="site-header__logo" href="/" aria-label="HAMZATOVIC daily — на главную">
    <Logo class="site-header__logo-img--desktop" />
    <Logo compact class="site-header__logo-img--mobile" />
  </a>
  <nav class="site-header__nav" aria-label="Разделы">
    <a href="/lenta/">Лента</a>
    <a href="/toma/">Тома</a>
    <a href="/o-zhurnale/">О журнале</a>
    <ThemeToggle />
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  let previousY = window.scrollY;
  window.addEventListener('scroll', () => {
    const currentY = window.scrollY;
    if (Math.abs(currentY - previousY) < 8) return;
    header?.classList.toggle('site-header--hidden', currentY > previousY && currentY > 120 && !document.querySelector('dialog[open]'));
    previousY = currentY;
  }, { passive: true });
  document.querySelectorAll<HTMLDetailsElement>('.reading-toc').forEach(toc => {
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && toc.open) {
        toc.open = false;
        toc.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', event => {
      if (event.target instanceof Node && !toc.contains(event.target)) toc.open = false;
    });
  });
</script>

<style>
  .site-header {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 88px;
    padding: 0 var(--space-48);
    border-bottom: var(--hairline) solid var(--ink);
  }

  .site-header__tome {
    justify-self: start;
    font-family: var(--font-text);
    font-style: italic;
    color: var(--ink);
    text-decoration: none;
  }

  .site-header__logo {
    color: var(--ink);
    justify-self: center;
    display: block;
    line-height: 0;
  }

  :global(.site-header__logo-img--desktop) {
    display: block;
    height: 30px;
    width: auto;
  }

  .site-header__nav {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-24);
    font-family: var(--font-text);
  }

  .site-header__nav a {
    color: var(--ink);
    text-decoration: none;
  }

  .site-header__tome--mobile,
  :global(.site-header__logo-img--mobile) {
    display: none;
  }

  .reading-toc summary {
    cursor: pointer;
    list-style: none;
    min-height: 44px;
    display: flex;
    align-items: center;
    font-size: var(--fs-meta);
  }
  .reading-toc summary::-webkit-details-marker { display: none; }
  .reading-toc__panel {
    max-height: calc(100dvh - 88px);
    overflow-y: auto;
    overscroll-behavior: contain;
    white-space: normal;
    overflow-wrap: anywhere;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 20;
    padding: var(--space-24) var(--page-margin-mobile);
    background: var(--paper);
    border-bottom: var(--hairline) solid var(--ink);
    font-size: var(--fs-flap-text);
    line-height: var(--lh-flap-text);
  }
  .reading-toc__panel ol { margin: var(--space-16) 0 0; padding-left: var(--space-24); }
  .reading-toc__panel li { padding: var(--space-8) 0; }
  .reading-toc__panel a { color: var(--ink); text-decoration: none; display: block; }
  .reading-toc__panel [aria-current] { font-weight: 700; text-decoration: underline; text-decoration-color: var(--tome); }
  .reading-toc__panel [data-read]::after { content: ' · прочитано'; font-size: var(--fs-meta); }

  /* Телефон и планшет: шапка 56px, слева номер материала, логотип мельче, меню — в подвале. */
  @media (max-width: 1024px) {
    .site-header {
      position: sticky;
      top: var(--page-frame);
      z-index: 110;
      background: var(--paper);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-16);
      height: 56px;
      padding: 0 var(--page-margin-mobile);
    }

    .site-header__tome--desktop,
    :global(.site-header__logo-img--desktop) {
      display: none;
    }

    .site-header__tome--mobile {
      display: none;
      flex: none;
      white-space: nowrap;
    }

    .site-header__logo {
      min-width: 0;
      overflow: hidden;
    }

    :global(.site-header__logo-img--mobile) {
      display: block;
      max-height: 17px;
      max-width: 100%;
      width: auto;
      height: 17px;
    }

    .site-header__nav a {
      display: none;
    }
    .site-header--hidden:not(:focus-within) { transform: translateY(calc(-100% - var(--page-frame))); }
    @media(prefers-reduced-motion:no-preference) { .site-header { transition: transform 160ms ease-out; } }
  }
</style>
