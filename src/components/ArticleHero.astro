---
// docs/components.md → ArticleHero
import type { CollectionEntry } from 'astro:content';
import { AUTHORS } from '../lib/content/authors';
import { readingTimeLabel } from '../lib/format/pluralize';

interface Props {
  entry: CollectionEntry<'articles'>;
  position: number;
  total: number;
}
const { entry, position, total } = Astro.props;
const { title, subtitle, tome, genre, author, readingTime, cover, coverSvg, coverAlt } = entry.data;
const authorInfo = AUTHORS[author];
const coverSrc = coverSvg ?? cover;
---

<section class="article-hero">
  <div class="article-hero__cover">
    {coverSrc && <img src={coverSrc} alt={coverAlt} width="640" height="853" />}
  </div>
  <div class="article-hero__content">
    <p class="article-hero__meta article-hero__meta--desktop">{genre}. Том {tome}, материал {position} из {total}</p>
    <p class="article-hero__meta article-hero__meta--mobile">{genre} · материал {position} из {total}</p>
    <h1 class="article-hero__title">{title}</h1>
    <p class="article-hero__subtitle">{subtitle}</p>
    <div class="article-hero__byline">
      <span class="article-hero__author">{authorInfo.name}</span>
      {readingTime !== null && <span class="article-hero__time">{readingTimeLabel(readingTime)}</span>}
    </div>
  </div>
</section>

<script>
  // design/brandbook/README.md: для длинных слов article-title уменьшать до 72–80px,
  // чтобы слово не вылезало за колонку.
  const MIN_SIZE = 72;
  const STEP = 4;

  function fitTitle(el: HTMLElement) {
    let size = parseFloat(getComputedStyle(el).fontSize);
    while (el.scrollWidth > el.clientWidth && size > MIN_SIZE) {
      size -= STEP;
      el.style.fontSize = `${size}px`;
    }
  }

  const title = document.querySelector<HTMLElement>('.article-hero__title');
  if (title) fitTitle(title);
</script>

<style>
  .article-hero {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--space-24);
    padding: 0 var(--space-48);
  }

  .article-hero__cover {
    grid-column: 1 / span 6;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .article-hero__cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-hero__content {
    grid-column: 7 / span 6;
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding-top: var(--space-32);
  }

  .article-hero__meta {
    margin: 0;
    font-family: var(--font-text);
    font-style: italic;
    font-size: var(--fs-flap-label);
    line-height: var(--lh-flap-label);
  }

  .article-hero__title {
    margin: var(--space-24) 0 0;
    font-family: var(--font-display);
    font-size: var(--fs-article-title);
    line-height: var(--lh-article-title);
    text-wrap: balance;
  }

  .article-hero__subtitle {
    margin: var(--space-24) 0 0;
    font-family: var(--font-text);
    font-style: italic;
    font-size: var(--fs-lede);
    line-height: var(--lh-lede);
    max-width: var(--text-measure);
  }

  .article-hero__byline {
    margin-top: auto;
    padding-top: var(--space-32);
    border-top: var(--hairline) solid var(--ink);
    display: flex;
    justify-content: space-between;
    font-family: var(--font-text);
  }

  .article-hero__author {
    font-weight: 700;
  }

  .article-hero__meta--mobile {
    display: none;
  }

  /* Телефон и планшет: обложка во всю ширину сверху, обрезана по высоте. */
  @media (max-width: 1024px) {
    .article-hero {
      display: block;
      padding: 0 var(--page-margin-mobile);
    }

    .article-hero__cover {
      margin: 0 calc(var(--page-margin-mobile) * -1);
      aspect-ratio: auto;
      height: 300px;
    }

    .article-hero__content {
      padding-top: var(--space-24);
    }

    .article-hero__meta--desktop {
      display: none;
    }

    .article-hero__meta--mobile {
      display: block;
    }

    .article-hero__title {
      margin-top: var(--space-16);
      font-size: var(--fs-article-title-mobile);
      line-height: 1.1;
      overflow-wrap: break-word;
    }

    .article-hero__subtitle {
      margin-top: var(--space-16);
      font-size: 16px;
      line-height: 1.4;
    }

    .article-hero__byline {
      padding-top: var(--space-16);
    }
  }
</style>
