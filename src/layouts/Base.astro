---
import { getCollection } from 'astro:content';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/print.css';
// Предзагрузка двух основных начертаний (docs/quality.md → Типографика).
import delaCyrillicUrl from '@fontsource/dela-gothic-one/files/dela-gothic-one-cyrillic-400-normal.woff2?url';
import literataCyrillicUrl from '@fontsource/literata/files/literata-cyrillic-400-normal.woff2?url';
import literataLatinUrl from '@fontsource/literata/files/literata-latin-400-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Номер тома. Без него — текущий том (последний опубликованный). */
  tome?: number;
  /** Картинка превью для Open Graph / Twitter. На первом этапе — обложка материала. */
  image?: string;
  type?: 'website' | 'article';
  coverFrame?: boolean;
}

const { title, description, tome: tomeNumber, image, type = 'website', coverFrame = false } = Astro.props;

const tomes = (await getCollection('tomes', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.number - a.data.number);
const tome = tomeNumber === undefined
  ? tomes[0]
  : tomes.find(({ data }) => data.number === tomeNumber);

if (!tome) {
  throw new Error(`Том ${tomeNumber ?? '(текущий)'} не найден среди опубликованных в src/content/tomes/`);
}

const siteName = 'HAMZATOVIC daily';
const pageTitle = title ? `${title} — ${siteName}` : siteName;
const pageDescription = description ?? tome.data.lede;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = image ? new URL(image, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="ru" data-tome={tome.data.color} data-reading={type === 'article' ? 'true' : undefined} data-cover-frame={coverFrame ? 'true' : undefined}>
  <head>
    <meta charset="utf-8" />
    <link rel="preload" as="font" type="font/woff2" href={delaCyrillicUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={literataCyrillicUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={literataLatinUrl} crossorigin />
    <script is:inline>
      // Тема до первой отрисовки, чтобы ночью не было белой вспышки.
      // Пусто — следуем prefers-color-scheme (правило в tokens.css).
      try {
        var theme = localStorage.getItem('theme');
        if (theme === 'day' || theme === 'night') document.documentElement.dataset.theme = theme;
      } catch (e) {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="ru_RU" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <slot name="head" />
  </head>
  <body>
    {coverFrame && <div class="cover-frame" aria-hidden="true" />}
    <slot name="frame" />
    <slot />
    <script>
      function revealNote(hash: string) {
        const note = document.getElementById(hash.replace(/^#/, ''));
        if (note instanceof HTMLDetailsElement && note.classList.contains('sidenote')) note.open = true;
      }
      document.addEventListener('click', (event) => {
        const link = (event.target as Element).closest<HTMLAnchorElement>('a[role="doc-noteref"]');
        if (link) revealNote(link.hash);
      });
      window.addEventListener('hashchange', () => revealNote(location.hash));
      revealNote(location.hash);
      document.querySelectorAll<HTMLAnchorElement>('.margin-quote-share, .article-share').forEach((link) => {
        link.addEventListener('click', async (event) => {
          if (!navigator.share && !navigator.clipboard) return;
          event.preventDefault();
          const url = new URL('#quote', location.href).href;
          try {
            if (navigator.share) await navigator.share({ title: document.title, url });
            else {
              await navigator.clipboard.writeText(url);
              link.textContent = 'Ссылка скопирована';
            }
          } catch (error) {
            if (!(error instanceof DOMException && error.name === 'AbortError')) location.hash = 'quote';
          }
        });
      });
    </script>
  </body>
</html>
